# Copy to an operator-owned file on each rank; edit paths and private-link settings.
# Values are Bash assignments, loaded by launch-rank.sh. No credentials belong here.
BIN_ROOT=/opt/tensorfold
MODEL_DIR=/assets/eaq-keys/model
CHECKPOINT_DIR=/assets/eaq-keys/checkpoint
RANK_CACHE_DIR=/assets/eaq-keys/rank-cache
TF_DS_KIT=/assets/kit-capacity/kit
TF_DS_ENGRAM=/assets/engram
TF_DS_TOKEN_MAP=/assets/eaq-keys/dsv41_token_map.json
# RFC 5737 example only: replace with the head's address on the private CX7 link.
TF_TP_MASTER=192.0.2.1
TF_TP_PORT=29620
# Replace these example interface/device names with the real twin rails on each Spark.
NCCL_SOCKET_IFNAME=YOUR_CX7_NETDEV
TF_RDMA_DEVICES=YOUR_FIRST_RDMA_DEVICE,YOUR_SECOND_RDMA_DEVICE
TF_RDMA_GID_INDEX=3
API_HOST=127.0.0.1
API_PORT=8888
# API_KEY_FILE=/run/secrets/tensorfold-api-key
TF_DS_ROUND_MS=30.0,35.2,39.9,44.9,48.6,52.1,55.6,59.1,62.7,66.3,69.6,72.9,75.5,78.2,81.3,84.4,87.5,90.6,93.7,96.8,99.9,103.0,106.1,109.2,112.2,115.3,122.0,123.9,125.5,127.2,130.5,134.6,138.8,142.9,145.9,148.2,150.6,152.9,155.3,157.6,160.0,162.3,164.7,167.0,169.4,171.7,174.1,176.4,179.0,181.6,184.2,186.9,189.5,192.1,194.7,197.3,199.9,202.5,205.1,207.8,210.4,213.0,215.6,218.2
