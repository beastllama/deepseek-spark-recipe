+        fn part(ptr: *anyopaque, s: *lanes.Stream, chunks: usize) anyerror!bool {
+            const target: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            const x: *@This() = @ptrCast(@alignCast(target.prefill_hook_ctx.?));
+            if (s.cut_in_limit > 0) {
+                x.calls += 1;
+                if (!x.later or x.calls > 1) return x.failure;
+            }
+            const be = target.backend();
+            return be.vtable.prefill_part.?(be.ptr, s, chunks);
+        }
+        fn backend(target: *lanes.fake.Fake) lanes.backend.Backend {
+            const table: lanes.backend.Backend.VTable = comptime blk: {
+                var unused: lanes.fake.Fake = undefined;
+                var v = unused.backend().vtable.*;
+                v.prefill_part = part;
+                break :blk v;
+            };
+            return .{ .ptr = target, .vtable = &table };
+        }
