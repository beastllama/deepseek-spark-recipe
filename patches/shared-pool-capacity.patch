--- a/zig/src/families/dsv41/pool_geometry.zig
+++ b/zig/src/families/dsv41/pool_geometry.zig
@@ -0,0 +1,43 @@
+//! Physical cache capacity is independent of one request's logical sequence limit.
+const std = @import("std");
+
+pub const Geometry = struct {
+    context: usize,
+    pool: usize,
+
+    pub fn init(context: usize, pool: usize) !Geometry {
+        if (context == 0 or pool < context or pool > (1 << 20)) return error.BadPoolCapacity;
+        return .{ .context = context, .pool = pool };
+    }
+
+    /// Absent override preserves the existing context-sized pool exactly.
+    pub fn fromText(context: usize, text: ?[]const u8) !Geometry {
+        const value = text orelse return init(context, context);
+        const pool = std.fmt.parseInt(usize, value, 10) catch return error.BadPoolCapacity;
+        if (pool % 2048 != 0) return error.BadPoolCapacity;
+        return init(context, pool);
+    }
+};
+
+test "separate pool keeps logical context and every output reservation" {
+    const g = try Geometry.fromText(524288, "655360");
+    try std.testing.expectEqual(@as(usize, 524288), g.context);
+    try std.testing.expectEqual(@as(usize, 655360), g.pool);
+    var reserved: usize = 0;
+    for ([_]usize{ 115825, 116849, 118897, 122993 }) |prompt| {
+        reserved += std.mem.alignForward(usize, prompt + 32768 + 64 + 2, 2048);
+    }
+    try std.testing.expectEqual(@as(usize, 612352), reserved);
+    try std.testing.expect(reserved > g.context and reserved <= g.pool);
+}
+
+test "default geometry is unchanged and invalid overrides fail closed" {
+    for ([_]usize{ 16385, 262144, 524288, 1048576 }) |context| {
+        const g = try Geometry.fromText(context, null);
+        try std.testing.expectEqual(context, g.context);
+        try std.testing.expectEqual(context, g.pool);
+    }
+    for ([_][]const u8{ "", "0", "262144", "655361", "1048577", "-1", "no", "9999999999999999999999999" }) |bad|
+        try std.testing.expectError(error.BadPoolCapacity, Geometry.fromText(524288, bad));
+    try std.testing.expectError(error.BadPoolCapacity, Geometry.init(0, 655360));
+}
