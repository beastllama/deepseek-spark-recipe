+        }
+        checkTraffic(await idle());
+        if (traffic.discarded) throw new Error('Outside traffic before admission wave');
+        stage = 'Four requests: 32K output allowance, High, natural completion'; onStep?.(stage);
+        const waveStart = performance.now();
+        const tails = [1024, 2048, 4096, 8192];
+        const wave = await Promise.all(tails.map((tail, i) => ask(`Admission tail ${tail}`,
+          prefix + `\nContinuation ${i + 1}.` + ' harbor'.repeat(tail) +
+          '\nEND REFERENCE. Give exactly 12 concise numbered checks for a safe database backup and restore. Explain the purpose of each in one sentence. Stop after check 12.', sample, 32768).promise));
+        const waveDurationMs = performance.now() - waveStart;
+        // Repeated space-prefixed words are one token each for this fixture.
+        // Allow 256 tokens for chat framing/instructions, and at most one
+        // 2048-row placement block of prefix rounding. Report actual values.
+        const valid = wave.every((r,i) => !r.error && r.finishReason === 'stop' &&
+          Number.isFinite(r.ttftContentMs) && r.ttftContentMs >= 0 &&
+          Number.isInteger(r.reportedPromptTokens) && r.reportedPromptTokens >= 110000 && r.reportedPromptTokens <= 126000 &&
+          r.reportedPromptTokens - prime.reportedPromptTokens >= tails[i] - 256 &&
+          r.reportedPromptTokens - prime.reportedPromptTokens <= tails[i] + 256 &&
+          Number.isInteger(r.cachedTokens) && r.cachedTokens >= prime.reportedPromptTokens - 2048 && r.cachedTokens <= prime.reportedPromptTokens &&
+          Number.isInteger(r.uncachedPromptTokens) && r.uncachedPromptTokens > 0);
+        samples.push({ sample, comparisonValid: valid, waveDurationMs,
+          completedRequests: wave.filter(r => !r.error && r.finishReason === 'stop').length,
+          requestsPerMinute: valid ? 4 * 60000 / waveDurationMs : null,
+          meanCompletionMs: wave.reduce((n,r) => n + r.totalMs, 0) / 4,
+          meanFirstAnswerMs: valid ? wave.reduce((n,r) => n + r.ttftContentMs, 0) / 4 : null,
+          p95LongestPauseMs: p95LongestPause(wave) });
+        if (!valid) throw new Error('Admission sample lacks natural completion, first answer, or expected native prompt/cache geometry');
+        await finishTraffic();
+        continue;
+      }
+      const A = replayFiller(s, 94535);
+      const short = A + ' Tail eleven. ' + replayFiller(s + 1, 148);
+      const big = A + ' Tail twelve. ' + replayFiller(s + 2, 8863);
+      stage = `Sample ${sample}/${cells.length}: prime 126K prefix`; onStep?.(stage);
+      const prime = await ask('126K prime', mode.startsWith('branch') ? A : short, sample).promise;
