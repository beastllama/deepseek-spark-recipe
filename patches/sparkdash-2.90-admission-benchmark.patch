+        if (![extension.reportedPromptTokens, prime.reportedPromptTokens].every(v => Number.isInteger(v) && v > 0)) throw new Error('Native prompt token counts unavailable');
+        const actual = extension.reportedPromptTokens - prime.reportedPromptTokens;
