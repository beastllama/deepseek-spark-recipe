+ for(const r of [null,receipt({poolTokens:524288}),(()=>{const x=receipt();delete x.poolTokens;return x;})()]){
+  const p=probe(health,r);p._applyTensorFoldPool(health);await p._refreshNativeSharedPool(health);
+  assert.equal(p._nativeContextTokens,null);assert.equal(p.kvCacheTokens,655360);
+  const c=await p.getSharedPoolCapacity();assert.equal(c.contextTokens,null);assert.equal(c.capacityTokens,655360);
+ }
+});
+test('invalid explicit pool never falls back to logical capacity',async()=>{
+ for(const value of [0,-1,null,'bad']){const p=probe({...health,pool_tokens:value});assert.equal(await p.getSharedPoolCapacity(),null);}
+});
+test('legacy native context remains capacity only when both reads omit pool',async()=>{
+ const h={status:'ok',warming:false};const r=receipt();delete r.poolTokens;
+ assert.equal((await probe(h,r).getSharedPoolCapacity()).capacityTokens,524288);
+ assert.equal(await probe(h,receipt()).getSharedPoolCapacity(),null);
+});
+test('remote model has explicit pool but no host-derived context',async()=>{
+ const p=probe();p.spark.llmHost='192.0.2.1';assert.equal((await p.getSharedPoolCapacity()).contextTokens,null);
+});
