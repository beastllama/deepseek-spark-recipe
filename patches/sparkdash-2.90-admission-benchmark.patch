+import { createHash } from 'node:crypto';
+import { runStreamingRequest, sleep } from './LlmStreaming.js';
+import { streamPauseMeter, p95LongestPause } from './streamPause.js';
+
+const WORDS = 'harbor ledger copper window marble signal orchard violet engine paper silver lantern meadow anchor cobalt thistle granite ribbon falcon ember quartz willow saddle beacon canyon velvet timber russet nickel fennel garnet pillow summit drizzle walnut cinder trellis pebble mantle saffron'.split(' ');
+
+// System.Random(int) compatibility with the owner's PowerShell replay fixture.
+export function replayRandom(seed) {
+  const a = new Array(56).fill(0), max = 2147483647;
+  let mj = 161803398 - Math.abs(seed), mk = 1;
+  a[55] = mj;
+  for (let i = 1; i < 55; i++) {
+    const ii = (21 * i) % 55; a[ii] = mk; mk = mj - mk;
+    if (mk < 0) mk += max; mj = a[ii];
+  }
+  for (let k = 0; k < 4; k++) for (let i = 1; i < 56; i++) {
+    a[i] -= a[1 + (i + 30) % 55]; if (a[i] < 0) a[i] += max;
+  }
+  let next = 0, nextp = 21;
+  return () => {
+    if (++next >= 56) next = 1; if (++nextp >= 56) nextp = 1;
+    let r = a[next] - a[nextp]; if (r === max) r--; if (r < 0) r += max;
+    a[next] = r; return r / max;
+  };
+}
+
+export function replayFiller(seed, words) {
+  const random = replayRandom(seed), out = [`Document seed ${seed}. `];
+  for (let i = 0; i < words; i++) out.push(WORDS[Math.floor(random() * WORDS.length)], i % 17 === 16 ? '. ' : ' ');
+  return out.join('');
+}
+
+export function validateCachedTail(mode, mixed = false, hot = false) {
+  if (mode == null || mode === '') return null;
+  if (!['replay', 'replay-candidate', 'pause', 'pause-candidate', 'branch', 'branch-resume', 'admission'].includes(mode) || mixed || hot) {
+    const err = new Error('Choose cached-tail replay or pause alone'); err.status = 400; throw err;
+  }
+  return mode;
+}
+
+export function replayGate(streams) {
+  const a = streams.find(s => s.probeRole === '12K alone');
+  const q = streams.find(s => s.probeRole === '12K queued');
+  const b = streams.find(s => s.probeRole === '63K blocker');
+  // Declared reproduction band, not a speed-improvement acceptance threshold.
+  return !!a && !!q && !!b && [a,q].every(s => !s.error && s.cachedTokens === 124928)
+    && b.cachedTokens === 0 && !b.error && q.overlappedColdFill === true
+    && Number.isFinite(a.nativeTtftSeconds) && Number.isFinite(q.nativeTtftSeconds)
+    && a.nativeTtftSeconds >= 4.4 && a.nativeTtftSeconds <= 9.2 && q.nativeTtftSeconds >= 19.9 && q.nativeTtftSeconds <= 41.3;
+}
+
+export function candidateReplayGate(streams) {
+  const a = streams.find(s => s.probeRole === '12K alone');
+  const q = streams.find(s => s.probeRole === '12K queued');
+  const b = streams.find(s => s.probeRole === '63K blocker');
+  // Measurement validity only: improvement/regression is assessed against a separate baseline.
+  return !!a && !!q && !!b && [a,q].every(s => !s.error && s.cachedTokens === 124928)
+    && b.cachedTokens === 0 && !b.error && q.overlappedColdFill === true
+    && [a,q].every(s => Number.isFinite(s.nativeTtftSeconds) && s.nativeTtftSeconds >= 0);
+}
+
+export function outsideTraffic(start, current, submitted) {
+  const done = current.completed - start.completed;
+  return done < 0 || current.disconnects !== start.disconnects || done + current.running + current.waiting > submitted;
+}
+
+// This scenario measures queuing; unlike a decode wave it does not require all
+// four reservations to fit at once. Each full request must fit independently.
+export function validateAdmissionCapacity(poolTokens, contextTokens) {
+  if (!Number.isSafeInteger(poolTokens) || poolTokens < 524288 ||
+      !Number.isSafeInteger(contextTokens) || contextTokens < 163840) {
+    const err = new Error('Admission measurement requires fresh capacity: 524288 shared KV tokens and at least 163840 context');
+    err.status = 400; throw err;
+  }
+}
+
+export async function runCachedTailScenario({ baseUrl, modelId, mode, salt, abortSignal, apiKey, onStep, branchPrior = null }) {
+  const controller = new AbortController();
+  const abort = () => controller.abort();
+  if (abortSignal?.aborted) abort();
+  abortSignal?.addEventListener('abort', abort, { once: true });
+  const deadline = setTimeout(abort, 30 * 60_000);
+  const signal = controller.signal, pending = new Set(), streams = [], samples = [];
+  const started = performance.now();
+  const seed = createHash('sha256').update(salt).digest().readUInt32LE(0) % 100000000 + 10000;
+  const headers = apiKey ? { Authorization: `Bearer ${apiKey}` } : {};
+  let stage = '', error = null, drain = null, traffic = null, watchStop = null, watchPromise = null;
+  async function gauge(parentSignal = signal) {
+    const r = await fetch(`${baseUrl}/metrics`, { headers, signal: AbortSignal.any([parentSignal, AbortSignal.timeout(8000)]) });
+    if (!r.ok) throw new Error('Cannot read live request counts');
+    const text = await r.text();
+    const value = name => { const m = text.match(new RegExp(`^tensorfold:${name} (\\d+)`, 'm')); if (!m) throw new Error('Missing live request count'); return Number(m[1]); };
+    return { running: value('requests_running'), waiting: value('requests_waiting'), completed: value('request_latency_seconds_count'), disconnects: value('client_disconnections_total') };
+  }
+  async function idle() {
+    const g = await gauge(); if (g.running || g.waiting) throw new Error('Fleet is not idle; no scenario request submitted'); return g;
+  }
+  function checkTraffic(g) {
+    if (!traffic) return;
+    if (outsideTraffic(traffic.start, g, traffic.submitted)) traffic.discarded = true;
+    traffic.last = g;
+    if (mode === 'admission') {
+      traffic.maxRunning = Math.max(traffic.maxRunning ?? 0, g.running);
+      traffic.maxWaiting = Math.max(traffic.maxWaiting ?? 0, g.waiting);
+      if (traffic.discarded) abort(); // Cancel only this benchmark's requests.
+    }
+  }
+  async function finishTraffic() {
+    if (!traffic) return;
+    watchStop.abort(); await watchPromise;
+    const g = await gauge(); checkTraffic(g);
+    if (g.running || g.waiting || g.completed - traffic.start.completed !== traffic.submitted) traffic.discarded = true;
+    const row = samples.find(s => s.sample === traffic.sample) ?? { sample: traffic.sample };
+    if (!samples.includes(row)) samples.push(row);
+    row.traffic = { start: traffic.start, end: g, submitted: traffic.submitted, discarded: traffic.discarded,
+      ...(mode === 'admission' ? { maxRunning: traffic.maxRunning ?? 0, maxWaiting: traffic.maxWaiting ?? 0, samplingMs: 250 } : {}) };
+    if (traffic.discarded) {
+      row.reproduced = false; row.overlapVerified = false; row.discarded = true;
+      if (mode.endsWith('-candidate') || mode === 'admission') row.comparisonValid = false;
+      for (const s of streams.filter(s => s.sample === traffic.sample)) s.discarded = true;
+      traffic = null; throw new Error('Sample discarded: outside traffic, counter reset, disconnect or unverified request accounting');
+    }
+    traffic = null;
+  }
+  function ask(role, content, sample, maxTokens = 8) {
+    if (traffic?.discarded) throw new Error('Sample discarded: outside traffic detected');
+    if (traffic) traffic.submitted++;
+    const pause = streamPauseMeter();
+    const state = { first: null, last: null, done: false, result: null };
+    const body = { model: modelId, messages: [{ role: 'user', content }], max_tokens: maxTokens, temperature: 0, stream: true, stream_options: { include_usage: true } };
+    if (mode === 'admission') Object.assign(body, { temperature: 0.7, top_p: 1, top_k: 20, reasoning_effort: 'high' });
+    else if (maxTokens > 8) Object.assign(body, { min_tokens: maxTokens, ignore_eos: true, stop: [] });
+    const requestStartedAt = Date.now();
+    const promise = (async () => {
+      const r = await runStreamingRequest(`${baseUrl}/v1/chat/completions`, body, signal, {
+        apiKey, debug: true, retryOnThinking400: false,
+        onDelta(d) { pause.note(d); state.first ??= d.tFirst; state.last = d.tLast; },
+      });
+      const row = {
+        index: streams.length, sample, probeRole: role, ttftMs: r.ttftMs,
+        totalMs: r.totalMs, decodeTps: r.decodeTps, decodeTokens: r.decodeTokens,
+        completionTokens: r.completionTokens, prefillTokens: r.prefillTokens,
+        reportedPromptTokens: r.usage?.promptTokens ?? null, tokenSha: r.tensorfold?.tokenSha ?? null, nativeTtftSeconds: r.tensorfold?.ttftSeconds ?? null, nativePrefillSeconds: r.tensorfold?.prefillSeconds ?? null, cachedTokens: r.cachedPromptTokensReported ? r.cachedPromptTokens : null,
+        prefillTps: r.prefillTps, error: r.error ? 'Request failed' : (r.completionTokens > 0 ? null : 'No generated tokens'),
+        ...pause.result(), promptSha256: createHash('sha256').update(content).digest('hex'),
+        ...(mode === 'admission' ? {
+          maxOutputTokens: maxTokens, finishReason: r.finishReason ?? null,
+          ttftContentMs: r.ttftContentMs ?? null,
+          probeStartedAt: requestStartedAt, probeFinishedAt: Date.now(),
+          uncachedPromptTokens: r.cachedPromptTokensReported && Number.isFinite(r.usage?.promptTokens)
+            ? r.usage.promptTokens - r.cachedPromptTokens : null,
+        } : {}),
+      };
+      state.result = row; streams.push(row); return row;
+    })().finally(() => { state.done = true; pending.delete(promise); });
+    pending.add(promise); promise.catch(() => {}); state.promise = promise; return state;
+  }
+  async function waitFor(test, milliseconds, message) {
+    const until = performance.now() + milliseconds;
+    while (!test()) { if (performance.now() > until) throw new Error(message); await sleep(100, signal); }
+  }
+  try {
+    const prior = branchPrior?.samples ?? [];
+    const cells = mode === 'admission' ? [1] : mode.startsWith('branch') ? [1024, 2048, 4096, 8192, 12288, 200].filter(n => !prior.some(s => s.targetExtensionTokens === n)) : [1, 2, 3];
+    const initialCells = cells.length;
+    for (let sample = 1; sample <= cells.length; sample++) {
+      const startCounts = await idle();
+      traffic = { sample, start: startCounts, submitted: 0, discarded: false };
+      watchStop = new AbortController();
+      watchPromise = (async () => {
+        try {
+          while (!watchStop.signal.aborted) {
+            await sleep(250, watchStop.signal);
+            const g = await gauge(); checkTraffic(g);
+          }
+        } catch { if (!watchStop.signal.aborted && traffic) { traffic.discarded = true; if (mode === 'admission') abort(); } }
+      })();
+      const s = seed + sample * 100;
+      if (mode === 'admission') {
+        const prefix = 'The following reference is synthetic context. Ignore its word order. Follow the task after END REFERENCE.\n' + replayFiller(s, 86000);
+        stage = 'Prime one fresh approximately 115K prefix'; onStep?.(stage);
+        const prime = await ask('Admission prime', prefix, sample).promise;
+        if (traffic.discarded) throw new Error('Sample discarded: outside traffic or unverified live request counts during primer');
+        if (prime.error || prime.cachedTokens !== 0 || !Number.isInteger(prime.reportedPromptTokens) ||
