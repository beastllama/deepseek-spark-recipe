+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import { runCachedTailScenario, validateCachedTail, validateAdmissionCapacity } from '../CachedTailBench.js';
+import { validateDecodeBudget, validateDecodePoolBudget } from '../../validate.js';
+
+test('admission has bounded work and per-request capacity while allowing a queued fourth request', () => {
+  assert.equal(validateCachedTail('admission'), 'admission');
+  assert.throws(() => validateCachedTail('admission', true));
+  assert.throws(() => validateCachedTail('admission', false, true));
+  assert.doesNotThrow(() => validateAdmissionCapacity(524288, 262144));
+  for (const [pool,ctx] of [[null,262144],[524287,262144],[524288,null],[524288,163839],[Infinity,262144]]) {
+    assert.throws(() => validateAdmissionCapacity(pool, ctx));
+  }
+  assert.doesNotThrow(() => validateDecodeBudget([5],32768));
+  assert.doesNotThrow(() => validateDecodePoolBudget([1],126000,32768,524288));
+  assert.throws(() => validateDecodePoolBudget([4],126000,32768,524288));
+  const route=readFileSync(new URL('../../index.js',import.meta.url),'utf8');
+  const expression=route.match(/const concurrencies = (cachedTail \? [^;]+);/)?.[1];
+  assert.deepEqual(Array.from(runInNewContext(expression,{cachedTail:'admission'})),[4]);
+});
+
+test('admission uses natural completion, reports native cache and completion time, and rejects invalid samples', {timeout:15000}, async t => {
+  let running=0, completed=0, calls=0, fixture='valid';
+  const bodies=[];
+  const server=http.createServer(async(req,res)=>{
+    if(req.url==='/metrics') {
+      const observed=fixture==='busy'?1:fixture==='outside-prime'&&running>0?running+1:running;
+      if(fixture==='busy')fixture='valid'; // Busy at entry; idle at cleanup.
+      return res.end(`tensorfold:requests_running ${observed}\ntensorfold:requests_waiting 0\ntensorfold:request_latency_seconds_count ${completed}\ntensorfold:client_disconnections_total 0\n`);
+    }
+    let raw='';for await(const chunk of req)raw+=chunk;
+    const body=JSON.parse(raw);bodies.push(body);calls++;
+    // Concurrent HTTP requests may arrive in a different order. Native token
+    // counts belong to the request's continuation, not its arrival position.
+    const position=body.max_tokens===8?0:Number(body.messages[0].content.match(/\nContinuation ([1-4])\./)[1]);
+    running++;res.setHeader('content-type','text/event-stream');
+    res.write('data: '+JSON.stringify({choices:[{delta:{reasoning_content:'Checking.'}}]})+'\n\n');
+    setTimeout(()=>{
+      const cached=position===0?0:fixture==='cache-loss'?100001:114560;
+      const usage={prompt_tokens:position===0?114688:114688+[1024,2048,4096,8192][position-1],completion_tokens:20};
+      if(fixture==='wrong-geometry'&&position>0)usage.prompt_tokens=115712;
+      if(fixture!=='missing-cache'||position===0)usage.prompt_tokens_details={cached_tokens:cached};
+      running--;completed++;
+      res.end('data: '+JSON.stringify({choices:[{delta:{content:'1. Verify the backup.'},finish_reason:fixture==='truncated'&&position>0?'length':'stop'}],usage})+'\n\ndata: [DONE]\n\n');
+      if(fixture==='outside'&&position===4)completed++;
+    },fixture==='outside-prime'?400:30);
+  });
+  await new Promise(r=>server.listen(0,'127.0.0.1',r));
+  t.after(()=>{server.closeAllConnections();server.close();});
+  const options={baseUrl:`http://127.0.0.1:${server.address().port}`,modelId:'fixture',mode:'admission',salt:'admission-offline'};
+  const result=await runCachedTailScenario(options);
+  assert.equal(result.error,null);assert.equal(result.concurrency,4);assert.equal(result.streams.length,5);
+  assert.equal(result.samples.length,1);assert.equal(result.samples[0].comparisonValid,true);
+  assert.equal(result.samples[0].traffic.submitted,5);assert.equal(result.samples[0].completedRequests,4);
+  assert.ok(result.samples[0].waveDurationMs>0);assert.ok(result.samples[0].requestsPerMinute>0);
+  assert.equal(bodies[0].max_tokens,8);
+  for(const body of bodies.slice(1)){
+    assert.equal(body.max_tokens,32768);assert.equal(body.reasoning_effort,'high');
+    assert.equal(body.temperature,0.7);assert.equal(body.top_k,20);
+    for(const key of ['min_tokens','ignore_eos','stop'])assert.equal(key in body,false);
+  }
+  for(const row of result.streams.slice(1)){
+    assert.equal(row.maxOutputTokens,32768);assert.equal(row.cachedTokens,114560);
+    assert.equal(row.uncachedPromptTokens,row.reportedPromptTokens-114560);
+    assert.equal(row.finishReason,'stop');assert.ok(row.ttftContentMs>=0);
+    assert.equal('contentPreview' in row,false);assert.equal('prompt' in row,false);
+  }
+  for(const invalid of ['missing-cache','truncated','outside','wrong-geometry','cache-loss']){
+    fixture=invalid;
+    const r=await runCachedTailScenario(options);
+    assert.ok(r.error,invalid);assert.equal(r.samples[0].comparisonValid,false,invalid);
+    assert.equal(r.samples[0].discarded,true,invalid);
+  }
+  const beforeOutside=calls;fixture='outside-prime';
+  const contaminated=await runCachedTailScenario(options);
+  assert.match(contaminated.error,/Sample discarded: outside traffic/);
+  assert.equal(calls-beforeOutside,1,'must not submit the measured wave after contamination');
+  assert.equal(contaminated.samples[0].comparisonValid,false);
+  const before=calls;fixture='busy';
+  const busy=await runCachedTailScenario({...options,abortSignal:AbortSignal.timeout(100)});
+  assert.match(busy.error,/not idle/);assert.equal(calls,before);
+});
