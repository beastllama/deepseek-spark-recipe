+          branchTtftMs: probe.ttftMs, retained: probe.cachedTokens === 124928 });
+      } else if (mode === 'replay' || mode === 'replay-candidate') {
+        stage = `Sample ${sample}/3: 12K alone`; onStep?.(stage);
+        const alone = await ask('12K alone', A + ' Tail ten. ' + replayFiller(s + 5, 8863), sample).promise;
+        if (alone.error || alone.cachedTokens !== 124928) throw new Error('Alone replay did not restore 124,928 tokens');
+        // Re-establish the near-A tip after the long continuation, exactly as replay3 does.
+        stage = `Sample ${sample}/3: restore near-A tip`; onStep?.(stage);
+        const reset = await ask('Near-A reset', short, sample).promise;
+        if (reset.error) throw new Error('Near-A reset failed');
+        stage = `Sample ${sample}/3: 12K behind cold 63K`; onStep?.(stage);
+        const blocker = ask('63K blocker', replayFiller(s + 3, 47267), sample);
+        const until = performance.now() + 20000;
+        while ((await gauge()).running < 1) {
