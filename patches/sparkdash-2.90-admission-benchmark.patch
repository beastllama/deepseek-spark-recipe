+const health = { status:'ok', warming:false, pool_tokens:655360, pool_free_tokens:123456 };
+const receipt = (extra={}) => ({capacityTokens:524288,poolTokens:655360,pid:123,startIdentity:'456',configSha256:'a'.repeat(64),source:'tensorfold-native-dsv41-process',observedAt:Date.now(),...extra});
+function probe(h=health,r=receipt()) {
+ const p=new LlmProbe({lanIp:'127.0.0.1'},8888,{readNativeSharedPool:async()=>r});
+ p.backendType='tensorfold';p.authOpen=true;
+ p._fetch=async()=>({ok:true,json:async()=>h});return p;
+}
+test('explicit physical pool retains a separate verified logical context',async()=>{
+ const p=probe();p._applyTensorFoldPool(health);await p._refreshNativeSharedPool(health);
+ assert.equal(p.kvCacheTokens,655360);assert.equal(p.kvCacheTokensAvailable,123456);assert.equal(p._nativeContextTokens,524288);
+ const c=await p.getSharedPoolCapacity();assert.equal(c.capacityTokens,655360);assert.equal(c.contextTokens,524288);assert.equal(c.availableTokens,123456);
+});
+test('optional native pool survives two parsing layers; malformed values fail',()=>{
+ const r=receipt();assert.deepEqual(parseNativeTensorFoldCapacity(parseNativeTensorFoldCapacity(r)),r);
+ for(const value of [null,0,-1,1.1,'655360',true])assert.equal(parseNativeTensorFoldCapacity(receipt({poolTokens:value})),null);
+});
