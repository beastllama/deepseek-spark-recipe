+        if (extension.error || extension.cachedTokens !== 124928) throw new Error('Branch point was not restorable before extension');
+        stage = `Branch cell ${sample}: different continuation from A`; onStep?.(stage);
+        const probe = await ask(`Branch after ${n}`, A + ' copper'.repeat(200), sample).promise;
