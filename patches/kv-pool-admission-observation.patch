+test "admission diagnostics observe a gate and cancellation without changing queue placement" {
+    const probe = @import("cache_refresh_borrow_test.zig");
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 0 });
+    defer {
+        host.closeAll();
+        host.stop();
+    }
+    const r: Request = .{ .prompt = &.{ 1, 2, 3 }, .max_tokens = 8, .drafts = false };
+    if (host.admission_trace == null) {
+        if (host.trace == null) {
+            host.trace = try gpa.create(LaneHost.SpanTrace);
+            host.trace.?.* = .{};
+        }
+        try host.engine().submit(41, &r, .{ .ctx = &target, .event = probe.event });
+        try std.testing.expect(!host.admitOne());
+        const pending_without_diagnostics = host.queued.items[0];
+        try std.testing.expect(!pending_without_diagnostics.admission_wait.enabled);
+        try std.testing.expectEqual(@as(?i96, null), pending_without_diagnostics.admission_wait.first_enqueue);
+        try std.testing.expectEqual(@as(u32, 0), pending_without_diagnostics.admission_wait.checks[@backingInt(admission.Gate.slots_full)]);
+        host.closeAll();
+
+        host.admission_trace = try gpa.create(LaneHost.AdmissionTrace);
+        host.admission_trace.?.* = .{};
+    }
+    try host.engine().submit(42, &r, .{ .ctx = &target, .event = probe.event });
+    try std.testing.expect(!host.admitOne());
+    try std.testing.expectEqual(@as(usize, 1), host.queued.items.len);
+    try std.testing.expectEqual(@as(u32, 1), host.queued.items[0].admission_wait.checks[@backingInt(admission.Gate.slots_full)]);
+    host.info_.lanes = 1;
+    _ = host.admitOne();
+    try std.testing.expectEqual(@as(usize, 1), host.admitted.items.len);
+    try std.testing.expectEqual(@as(u32, 8), host.admitted.items[0].stream.max_new);
+    try host.engine().submit(43, &r, .{ .ctx = &target, .event = probe.event });
+    try std.testing.expect(!host.admitOne());
+    host.closeAll();
+    const rows = host.admission_trace.?.admissions[0..host.admission_trace.?.admission_len];
+    try std.testing.expectEqual(@as(usize, 2), rows.len);
+    for (rows) |row| {
+        try std.testing.expectEqual(Reason.cancelled, row.reason);
+        try std.testing.expectEqual(@as(u32, 8), row.max_new);
+        try std.testing.expectEqual(@as(u32, if (row.id == 42) 1 else 0), row.wait.attempts);
+        var sum: u64 = 0;
+        for (row.wait.by_gate_ns) |ns| sum += ns;
+        try std.testing.expectEqual(row.wait.queue_ns, sum);
+    }
+}
