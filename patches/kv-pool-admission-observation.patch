+    defer gpa.destroy(trace);
+    trace.* = .{};
+    const row: LaneHost.AdmissionTrace.AdmissionRow = .{
+        .id = 7, .prompt = 3, .max_new = 8, .cached = 0, .reason = .stop, .wait = .{},
+    };
+    for (0..trace.admissions.len + 1) |_| trace.pushAdmission(row);
+    try std.testing.expectEqual(trace.admissions.len, trace.admission_len);
+    try std.testing.expectEqual(@as(u64, 1), trace.admission_dropped);
+
+    var important = row;
+    important.id = 8;
+    important.wait.queue_ns = LaneHost.AdmissionTrace.priority_wait_ns;
+    trace.pushAdmission(important);
+    try std.testing.expectEqual(@as(Id, 8), trace.overflowAt(0).id);
