+test "admission diagnostics preserve ContextFull evidence through a real host retry" {
+    const probe = @import("cache_refresh_borrow_test.zig");
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    if (host.admission_trace == null) {
+        host.admission_trace = try gpa.create(LaneHost.AdmissionTrace);
+        host.admission_trace.?.* = .{};
+    }
+    defer {
+        host.closeAll();
+        host.stop();
+    }
+    const r: Request = .{ .prompt = &.{ 1, 2, 3 }, .max_tokens = 8, .drafts = false };
+    try host.engine().submit(51, &r, .{ .ctx = &target, .event = probe.event });
+    _ = host.admitOne();
+    target.refuse_full = 1;
+    try host.engine().submit(52, &r, .{ .ctx = &target, .event = probe.event });
+    try std.testing.expect(!host.admitOne());
+    try std.testing.expectEqual(@as(usize, 1), host.queued.items.len);
+    const pending = host.queued.items[0];
+    try std.testing.expectEqual(@as(u32, 1), pending.admission_wait.context_full);
+    try std.testing.expectEqual(@as(u32, 1), pending.admission_wait.attempts);
+    try std.testing.expect(!pending.admission_wait.last_failed_placement.observed); // fake has no pool telemetry
+    try std.testing.expect(!host.admitOne()); // original per-job retry policy still applies
+    try std.testing.expect(pending.admission_wait.checks[@backingInt(admission.Gate.context_retry)] > 0);
+    pending.full_retry = 0; // advance just this fixture's retry deadline without sleeping
+    _ = host.admitOne();
+    try std.testing.expectEqual(@as(usize, 2), host.admitted.items.len);
+    try std.testing.expectEqual(@as(u32, 2), pending.admission_wait.attempts);
+    try std.testing.expectEqual(@as(u32, 1), pending.admission_wait.context_full);
+    try std.testing.expectEqual(@as(u32, 8), pending.stream.max_new);
+    try std.testing.expect(pending.admission_wait.first_enqueue.? <= pending.admission_wait.last_dequeue.?);
+}
