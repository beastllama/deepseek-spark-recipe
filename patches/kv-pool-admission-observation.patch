 test "a lane host serves the core's own tokens, in order, and cancels between rounds" {
     const gpa = std.testing.allocator;
diff --git a/zig/src/core/lanes/admission_observation.zig b/zig/src/core/lanes/admission_observation.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/lanes/admission_observation.zig
@@ -0,0 +1,179 @@
+//! Numeric-only admission diagnostics. No policy, prompt contents, or allocations.
+const std = @import("std");
+
+// Durations are time since the LAST OBSERVED gate, not proof that it blocked
+// continuously. Unexamined time is explicit; admission execution is excluded.
+pub const Gate = enum {
+    unexamined,
+    slots_full,
+    parked_fill,
+    borrowed_cache,
+    context_retry,
+    fill_wait,
+    cut_in_disabled,
+    no_cached_prefix,
+    cached_cut_in_ineligible,
+    finish_gate,
+};
+pub const gate_count = @typeInfo(Gate).@"enum".field_names.len;
+
+pub const Placement = struct {
+    observed: bool = false,
+    pool: usize = 0,
+    wanted: usize = 0,
+    reserved: usize = 0,
+    free: usize = 0,
+    largest: usize = 0,
+    live: usize = 0,
+};
+
+/// Union of live extents only. Kept-state protection is deliberately NOT
+/// represented as ordinary occupied capacity. Handles unsorted/overlapping input.
+pub fn measurePool(live: []const [2]usize, cap: usize, wanted: usize, alignment: usize) Placement {
+    var p: Placement = .{ .observed = true, .pool = cap, .wanted = wanted, .live = live.len };
+    var cursor: usize = 0;
+    while (cursor < cap) {
+        var next = cap;
+        var end = cursor;
+        for (live) |e| {
+            if (e[0] <= cursor and e[1] > cursor) end = @max(end, @min(e[1], cap));
+            if (e[0] > cursor) next = @min(next, e[0]);
+        }
+        if (end > cursor) {
+            cursor = end;
+        } else {
+            p.free += next - cursor;
+            const aligned = std.mem.alignForward(usize, cursor, alignment);
+            p.largest = @max(p.largest, next -| aligned);
+            cursor = next;
+        }
+    }
+    p.reserved = cap - p.free;
+    return p;
+}
+
+pub const Wait = struct {
+    enabled: bool = false,
+    first_enqueue: ?i96 = null,
+    last_dequeue: ?i96 = null,
+    queued_at: ?i96 = null,
+    last_at: i96 = 0,
+    last_gate: Gate = .unexamined,
+    queue_ns: u64 = 0,
+    by_gate_ns: [gate_count]u64 = @splat(0),
+    checks: [gate_count]u32 = @splat(0),
+    attempts: u32 = 0,
+    context_full: u32 = 0,
+    fill_busy: u32 = 0,
+    insufficient_total: u32 = 0,
+    fragmented: u32 = 0,
+    other_context_full: u32 = 0,
+    last_placement: Placement = .{},
+    last_failed_placement: Placement = .{},
+
+    pub fn enqueue(w: *Wait, at: i96, gate: Gate) void {
+        if (!w.enabled) return;
+        if (w.first_enqueue == null) w.first_enqueue = at;
+        w.queued_at = at;
+        w.last_at = at;
+        w.last_gate = gate;
+    }
+
+    fn account(w: *Wait, at: i96) void {
+        if (!w.enabled or w.queued_at == null) return;
+        const ns: u64 = @intCast(@min(std.math.maxInt(u64), @max(0, at - w.last_at)));
+        w.queue_ns +|= ns;
+        w.by_gate_ns[@backingInt(w.last_gate)] +|= ns;
+        w.last_at = @max(w.last_at, at);
+    }
+
+    pub fn observe(w: *Wait, gate: Gate, at: i96) void {
+        if (!w.enabled or w.queued_at == null) return;
+        w.account(at);
+        w.last_gate = gate;
+        w.checks[@backingInt(gate)] +|= 1;
+    }
+
+    pub fn dequeue(w: *Wait, at: i96) void {
+        if (!w.enabled or w.queued_at == null) return;
+        w.account(at);
+        w.queued_at = null;
+        w.last_dequeue = at;
+        w.attempts +|= 1;
+    }
+
+    pub fn end(w: *Wait, at: i96) void {
+        w.account(at); // includes a queued cancellation, without inventing an attempt
+        w.queued_at = null;
+    }
+
+    pub fn placement(w: *Wait, p: Placement, err: ?anyerror) void {
+        if (!w.enabled) return;
+        w.last_placement = p;
+        const failure = err orelse return;
+        if (failure == error.FillBusy) w.fill_busy +|= 1;
+        if (failure == error.ContextFull) {
+            w.context_full +|= 1;
+            w.last_failed_placement = p;
+            if (p.observed and p.wanted > p.free) {
+                w.insufficient_total +|= 1;
+            } else if (p.observed and p.wanted > p.largest) {
+                w.fragmented +|= 1;
+            } else w.other_context_full +|= 1; // does not invent a cache-victim cause
+        }
+    }
+};
+
+test "admission wait excludes attempt work and preserves distinct retry episodes" {
+    var w: Wait = .{ .enabled = true };
+    w.enqueue(100, .unexamined);
+    w.observe(.slots_full, 110);
+    w.observe(.slots_full, 130);
+    w.dequeue(150);
+    w.enqueue(1000, .context_retry); // 850ns inside attempted admission is NOT queue wait
+    w.observe(.unexamined, 1020);
+    w.dequeue(1030);
+    try std.testing.expectEqual(@as(u64, 80), w.queue_ns);
+    try std.testing.expectEqual(@as(u64, 20), w.by_gate_ns[@backingInt(Gate.unexamined)]);
+    try std.testing.expectEqual(@as(u64, 40), w.by_gate_ns[@backingInt(Gate.slots_full)]);
+    try std.testing.expectEqual(@as(u64, 20), w.by_gate_ns[@backingInt(Gate.context_retry)]);
+    try std.testing.expectEqual(@as(u32, 2), w.attempts);
+}
+
+test "admission disabled diagnostics are inert and queued cancellation is not an attempt" {
+    var off: Wait = .{};
+    off.enqueue(10, .unexamined);
+    off.observe(.slots_full, 20);
+    off.dequeue(30);
+    off.placement(.{}, error.ContextFull);
+    try std.testing.expectEqualDeep(Wait{}, off);
+    var on: Wait = .{ .enabled = true };
+    on.enqueue(10, .unexamined);
+    on.end(35);
+    try std.testing.expectEqual(@as(u64, 25), on.queue_ns);
+    try std.testing.expectEqual(@as(u32, 0), on.attempts);
+}
+
+test "admission pool distinguishes total free from contiguous aligned room" {
+    const p = measurePool(&.{ .{ 12, 16 }, .{ 0, 4 }, .{ 4, 6 } }, 24, 10, 4);
+    try std.testing.expectEqual(@as(usize, 10), p.reserved);
+    try std.testing.expectEqual(@as(usize, 14), p.free);
+    try std.testing.expectEqual(@as(usize, 8), p.largest);
+    var w: Wait = .{ .enabled = true };
+    w.placement(p, error.ContextFull);
+    try std.testing.expectEqual(@as(u32, 1), w.fragmented);
+    w.placement(measurePool(&.{.{ 0, 20 }}, 24, 8, 4), error.ContextFull);
+    try std.testing.expectEqual(@as(u32, 1), w.insufficient_total);
+    w.placement(measurePool(&.{}, 24, 8, 4), error.ContextFull);
+    try std.testing.expectEqual(@as(u32, 1), w.other_context_full);
+    w.placement(.{}, error.FillBusy);
+    try std.testing.expectEqual(@as(u32, 1), w.fill_busy);
+}
+
+test "admission pool unions overlaps and handles empty and full pools" {
+    const p = measurePool(&.{ .{ 8, 20 }, .{ 2, 10 } }, 24, 1, 4);
+    try std.testing.expectEqual(@as(usize, 6), p.free);
+    try std.testing.expectEqual(@as(usize, 4), p.largest);
+    try std.testing.expectEqual(@as(usize, 24), measurePool(&.{}, 24, 8, 4).largest);
+    try std.testing.expectEqual(@as(usize, 0), measurePool(&.{.{ 0, 24 }}, 24, 8, 4).free);
+}
