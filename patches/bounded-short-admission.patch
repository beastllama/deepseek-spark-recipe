+    /// Read-only conservative fit. Does not reserve a slot, touch snapshots, or call GPU/peer APIs.
+    fn admissionFitFn(ptr: *anyopaque, prompt: usize, max_new: u32) be.yield_observation.Fit {
+        const self = of(ptr);
+        const observation = be.yield_observation;
+        if (self.snaps.items.len > observation.snapshot_scan_limit) return .{ .status = .too_many_states, .pool = self.m.pool_cap };
+        var live: [observation.live_limit][2]usize = undefined;
+        var count: usize = 0;
+        var it = self.streams.valueIterator();
+        while (it.next()) |entry| {
+            if (count == live.len) return .{ .status = .too_many_states };
+            live[count] = .{ entry.base, entry.end };
+            count += 1;
+        }
+        var protected: [observation.protected_limit][2]usize = undefined;
+        var kept: usize = 0;
+        for (self.snaps.items) |sn| if (!sn.backed and !sn.stale) {
+            if (kept == protected.len) return .{ .status = .too_many_states };
+            protected[kept] = .{ sn.base, sn.base + sn.at };
+            kept += 1;
+        };
+        var slots_free: usize = 0;
+        for (self.used[0..self.m.streams]) |used| slots_free += @intFromBool(!used);
+        return observation.placement(live[0..count], protected[0..kept], self.m.context_cap,
+            self.m.pool_cap, prompt, max_new, self.m.eng.round_rows, slots_free);
+    }
+
     fn of(ptr: *anyopaque) *Lanes {
         return @ptrCast(@alignCast(ptr));
     }
