+    /// Probe the first eligible cold short behind the ordinary choice. Queue mutex held.
+    fn probeShort(h: *LaneHost, parent: *Job, chosen: usize, started: i96, scanned: *u64) ?yield_observation.Record {
+        const selected = h.queued.items[chosen];
+        const limit = @min(h.queued.items.len, yield_observation.scan_limit);
+        if (chosen + 1 >= limit) return null;
+        const active = h.core.activeCount();
+        for (h.queued.items[chosen + 1 .. limit], chosen + 1..) |job, index| {
+            scanned.* += 1;
+            const r = job.request;
+            if (r.prompt.len == 0 or r.prompt.len > yield_observation.short_prompt_limit or r.images.len > 0 or
+                r.background != selected.request.background or job.wait_for_fill) continue;
+            if (job.full_wait) |n| if (active > 0 and active >= n and started < job.full_retry) continue;
+            if (!h.core.cutsIn(r.prompt.len, false)) continue;
+            if (h.cache) |store| if (store.find(keyOf(r), r.chunks) != null) continue;
+            // Only the unlogged policy path can operate without an observed enqueue time.
+            const enqueued = job.admission_wait.first_enqueue orelse if (h.yield_trace != null) continue else started;
+            const probe_started = std.Io.Clock.awake.now(h.io).toNanoseconds();
+            const fit = if (h.core.backend.vtable.admission_fit) |probe|
+                probe(h.core.backend.ptr, r.prompt.len, r.max_tokens)
+            else yield_observation.Fit{};
+            const ended = std.Io.Clock.awake.now(h.io).toNanoseconds();
+            const probe_ns: u64 = @intCast(@max(0, ended - probe_started));
+            return .{ .at = probe_started, .parent = parent.id, .runnable = h.core.runnableCount(), .selected = selected.id,
+                .selected_prompt = selected.request.prompt.len, .candidate = job.id, .candidate_index = index,
+                .prompt = r.prompt.len, .max_new = r.max_tokens, .age = @intCast(@max(0, probe_started - enqueued)),
+                .fit = fit, .probe_ns = probe_ns, .total_ns = @intCast(@max(0, ended - started)) };
+        }
