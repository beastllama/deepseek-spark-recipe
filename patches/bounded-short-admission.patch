index 0000000000000000000000000000000000000000..ed92013ac39c6593d04b16c3263e52475aaebf73
--- /dev/null
+++ b/zig/src/core/lanes/yield_observation.zig
@@ -0,0 +1,127 @@
+//! Bounded numeric witnesses. A positive fit needs no snapshot eviction.
+const std = @import("std");
+const admission = @import("admission_observation.zig");
+
+pub const short_prompt_limit = 2048;
+pub const scan_limit = 32;
+pub const protected_limit = 64;
+pub const snapshot_scan_limit = 256;
+pub const live_limit = 32;
+pub const record_limit = 256;
+pub const grid = 2048;
+
+pub const Fit = struct {
+    pub const Status = enum(u8) { unknown, fits, no_room, no_slot, too_long, too_many_states };
+    status: Status = .unknown,
+    pool: usize = 0,
+    wanted: usize = 0,
+    free: usize = 0,
+    largest: usize = 0,
+    live: usize = 0,
+    protected: usize = 0,
+    slots_free: usize = 0,
+};
+
+/// Conservative placement: preserve every supplied legacy snapshot, even if normal placement could retire it.
+pub fn placement(live: []const [2]usize, protected: []const [2]usize, context: usize, pool: usize,
+    prompt: usize, max_new: u32, round_rows: usize, slots_free: usize) Fit {
+    var out: Fit = .{ .pool = pool, .live = live.len, .protected = protected.len, .slots_free = slots_free };
+    const with_output = std.math.add(usize, prompt, max_new) catch return out;
+    const with_round = std.math.add(usize, with_output, round_rows) catch return out;
+    const raw = std.math.add(usize, with_round, 2) catch return out;
+    const padded = std.math.add(usize, raw, grid - 1) catch return out;
+    out.wanted = padded / grid * grid;
+    if (prompt == 0 or out.wanted > context or out.wanted > pool) {
+        out.status = .too_long;
+        return out;
+    }
+    if (slots_free == 0) {
+        out.status = .no_slot;
+        return out;
+    }
+    if (live.len > live_limit or protected.len > protected_limit) {
+        out.status = .too_many_states;
+        return out;
+    }
+    var used: [live_limit + protected_limit][2]usize = undefined;
+    @memcpy(used[0..live.len], live);
+    @memcpy(used[live.len..][0..protected.len], protected);
+    const measured = admission.measurePool(used[0 .. live.len + protected.len], pool, out.wanted, grid);
+    out.free = measured.free;
+    out.largest = measured.largest;
+    out.status = if (out.largest >= out.wanted) .fits else .no_room;
+    return out;
+}
+
+pub const Record = struct {
+    at: i96,
+    parent: u64,
+    runnable: usize,
+    selected: u64,
+    selected_prompt: usize,
+    candidate: u64,
+    candidate_index: usize,
+    prompt: usize,
+    max_new: u32,
+    age: u64,
+    fit: Fit,
+    probe_ns: u64,
+    total_ns: u64,
+};
+
+pub const Trace = struct {
+    records: [record_limit]Record = undefined,
+    len: usize = 0,
+    opportunities: u64 = 0,
+    scanned: u64 = 0,
+    scan_limited: u64 = 0,
+    no_candidate: u64 = 0,
+    dropped_opportunities: u64 = 0,
+    probe_ns: u64 = 0,
+    total_ns: u64 = 0,
+
+    pub fn push(t: *Trace, row: Record) void {
+        if (t.len == record_limit) {
+            t.dropped_opportunities +|= 1;
+            return;
+        }
+        t.records[t.len] = row;
+        t.len += 1;
+    }
+};
