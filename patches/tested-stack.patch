+//! Small CPU adapters for LaneHost's cache borrow lifetime regressions.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const pc = @import("prompt_cache.zig");
+
+pub const Snaps = struct {
+    target: *lanes.fake.Fake,
+    stale: ?pc.Saved = null,
+    drops: usize = 0,
+    fn of(ptr: *anyopaque) *Snaps {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn bytes(_: *anyopaque, _: u32) u64 {
+        return 64;
+    }
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        return of(ptr).target.save(@ptrCast(@alignCast(owner.?)), at);
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+        return error.BackendRestores;
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const x = of(ptr);
+        x.drops += 1;
+        if (x.stale == saved) x.stale = null;
+        x.target.drop(saved);
+    }
+    fn usable(ptr: *anyopaque, saved: pc.Saved, _: usize) bool {
+        return of(ptr).stale != saved;
+    }
+    pub fn snapshots(x: *Snaps) pc.Snapshots {
+        return .{ .ptr = x, .vtable = &.{ .bytes = bytes, .save = save, .restore = restore, .drop = drop, .usable = usable } };
+    }
+};
+
+pub const FirstPiece = struct {
+    stream: ?*lanes.Stream = null,
+    reject_restore: bool = false,
+    after_restore: ?*const fn (s: *lanes.Stream) void = null,
+    fn part(ptr: *anyopaque, s: *lanes.Stream, _: usize) anyerror!bool {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        const x: *FirstPiece = @ptrCast(@alignCast(f.prefill_hook_ctx.?));
+        if (x.stream == null) {
+            x.stream = s;
+            const saved = s.reuse.saved;
+            if (x.reject_restore) {
+                s.reuse.saved = null;
+                s.reuse_failed = true;
+            }
+            defer if (x.reject_restore) {
+                s.reuse.saved = saved;
+            };
+            try f.backend().prefill(s); // Like native fillOpen: restore in the first piece, then yield before a keep.
+            if (x.after_restore) |hook| hook(s);
+            if (s.isCancelled()) return error.Cancelled;
+            return false;
+        }
+        std.debug.assert(x.stream == s);
+        return true;
+    }
+    const vtable: lanes.backend.Backend.VTable = blk: {
+        var f: lanes.fake.Fake = undefined;
+        var v = f.backend().vtable.*;
+        v.prefill_part = part;
+        break :blk v;
+    };
+    pub fn backend(f: *lanes.fake.Fake) lanes.backend.Backend {
+        return .{ .ptr = f, .vtable = &vtable };
+    }
+};
+
+pub fn event(_: *anyopaque, _: api.Id, _: *const api.Event) void {}
