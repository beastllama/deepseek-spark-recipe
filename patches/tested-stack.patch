+test "bounded graph eviction preserves ownership on failed sync or destroy and keeps the 96 limit" {
+    const Fake = struct {
+        var syncs: usize = 0;
+        var drops: usize = 0;
+        var fail_sync: bool = false;
+        var fail_drop: bool = false;
+        fn sync(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+            syncs += 1;
+            return if (fail_sync) cuda.abi.error_not_ready else cuda.abi.success;
+        }
+        fn drop(_: cuda.abi.GraphExec) callconv(.c) cuda.abi.Result {
+            drops += 1;
+            return if (fail_drop) cuda.abi.error_not_ready else cuda.abi.success;
+        }
+    };
+    var d: cuda.Driver = undefined;
+    d.api.cuStreamSynchronize = Fake.sync;
+    d.api.cuGraphExecDestroy = Fake.drop;
+    var e: Engine = undefined;
+    e.s = .{ .d = &d, .handle = null };
+    e.round_rows = 16;
+    var c: @import("config.zig").Config = undefined;
+    c.engram_layers = .{ .len = 2 };
+    e.c = &c;
+    var g = Graphs.init(std.testing.allocator);
+    defer g.deinit();
+    const cy: Carry = .{ .h = 1, .spare = 2, .pre = 3, .pre_f = 4 };
+    for (0..96) |i| try g.map.put(g.gpa, .{ .rows = 1, .bucket = i, .stretch = 0 }, .{
+        .exec = .{ .d = &d, .handle = @ptrFromInt(i + 1) },
+        .start = cy,
+        .end = cy,
+        .last_use = i,
+    });
+    try std.testing.expectEqual(@as(usize, 96), Graphs.capacity(&e));
+    Fake.fail_sync = true;
+    try std.testing.expectError(error.NotReady, g.makeRoom(&e));
+    try std.testing.expectEqual(@as(usize, 96), g.count());
+    try std.testing.expectEqual(@as(usize, 0), Fake.drops);
+    Fake.fail_sync = false;
+    Fake.fail_drop = true;
+    try std.testing.expectError(error.NotReady, g.makeRoom(&e));
+    try std.testing.expectEqual(@as(usize, 96), g.count());
+    try std.testing.expect(!g.eviction_reported);
+    Fake.fail_drop = false;
+    try g.makeRoom(&e);
+    try std.testing.expectEqual(@as(usize, 95), g.count());
+    try std.testing.expect(!g.map.contains(.{ .rows = 1, .bucket = 0, .stretch = 0 }));
+    try std.testing.expect(g.eviction_reported);
+    try std.testing.expectEqual(@as(usize, 3), Fake.syncs);
+    try std.testing.expectEqual(@as(usize, 2), Fake.drops);
+}
