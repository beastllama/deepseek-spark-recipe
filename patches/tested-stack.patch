+        }
+        fn launch(_: cuda.abi.GraphExec, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+            launches += 1;
+            return if (fail_launch) cuda.abi.error_not_ready else cuda.abi.success;
+        }
+        fn drop(_: cuda.abi.GraphExec) callconv(.c) cuda.abi.Result {
+            drops += 1;
+            return cuda.abi.success;
+        }
+    };
+    var d: cuda.Driver = undefined;
