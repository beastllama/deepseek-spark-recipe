+//! A failed CUDA capture restores host state and retries eagerly; graph ownership stays with the bounded caller.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const first_hold: u32 = 1024;
+pub const max_hold: u32 = first_hold << 6;
+pub const max_held_keys: usize = 96;
+
+pub fn holdFor(fails: u32) u32 {
+    const n: u5 = @intCast(@min(fails -| 1, std.math.log2_int(u32, max_hold / first_hold)));
+    return first_hold << n;
+}
+
+/// Only recording/allocation failures are retried; transport, pair, validation and unknown errors return unchanged.
+pub fn retryable(err: anyerror) bool {
+    return switch (err) {
+        error.CudaFailed, error.OutOfDeviceMemory, error.OutOfMemory, error.NotReady, error.MissingTritonVariant, error.NotFound, error.Invalid => true,
+        else => false,
+    };
+}
+
+/// A bounded LRU of failed keys; losing an old hold only makes that key eligible to capture sooner.
+pub fn Holds(comptime Key: type) type {
+    return struct {
+        const Self = @This();
+        pub const Hold = struct { left: u32, fails: u32, last_use: u64 };
+        map: std.AutoHashMapUnmanaged(Key, Hold) = .empty,
+        serial: u64 = 0,
+        limit: usize = max_held_keys,
+
+        pub fn deinit(h: *Self, gpa: std.mem.Allocator) void {
+            h.map.deinit(gpa);
+        }
+        fn stamp(h: *Self) u64 {
+            h.serial +%= 1;
+            return h.serial;
+        }
+
+        pub fn eager(h: *Self, key: Key) bool {
+            const x = h.map.getPtr(key) orelse return false;
+            x.last_use = h.stamp();
+            if (x.left == 0) return false;
+            x.left -= 1;
+            return true;
+        }
+
+        pub fn fail(h: *Self, gpa: std.mem.Allocator, key: Key) !Hold {
+            std.debug.assert(h.limit > 0 and h.limit <= max_held_keys);
+            if (!h.map.contains(key)) {
+                while (h.map.count() >= h.limit) {
+                    var it = h.map.iterator();
+                    var oldest = it.next().?;
+                    while (it.next()) |x| if (x.value_ptr.last_use < oldest.value_ptr.last_use) {
+                        oldest = x;
+                    };
+                    _ = h.map.remove(oldest.key_ptr.*);
+                }
+            }
+            const got = try h.map.getOrPut(gpa, key);
+            if (!got.found_existing) got.value_ptr.* = .{ .left = 0, .fails = 0, .last_use = 0 };
+            got.value_ptr.fails +|= 1;
+            got.value_ptr.left = holdFor(got.value_ptr.fails);
+            got.value_ptr.last_use = h.stamp();
+            return got.value_ptr.*;
+        }
+
+        pub fn clear(h: *Self, key: Key) void {
+            _ = h.map.remove(key);
+        }
+    };
+}
+
+pub const Cuda = struct {
+    pub const Stream = cuda.Stream;
+    pub const Graph = cuda.graph.Graph;
+    pub const Exec = cuda.graph.Exec;
+    pub fn begin(s: Stream) !void {
+        return cuda.graph.beginCapture(s, .thread_local);
+    }
+    pub fn end(s: Stream) !Graph {
+        return cuda.graph.endCapture(s);
+    }
+    pub fn instantiate(g: Graph) !Exec {
+        return g.instantiate();
+    }
+    pub fn launch(x: Exec, s: Stream) !void {
+        return x.launchOn(s);
+    }
+    pub fn ready(s: Stream) !bool {
+        return try cuda.graph.captureStatus(s) == .none;
+    }
+    pub fn dropGraph(g: *Graph) void {
+        g.deinit();
+    }
+    pub fn dropExec(x: *Exec) void {
+        x.deinit();
+    }
+};
+
+/// Capture only: site.reserve bounds/preallocates its map, site.keep takes exec ownership before its first launch.
+pub fn Capture(comptime G: type, comptime Key: type) type {
+    return struct {
+        const Self = @This();
+        gpa: std.mem.Allocator,
+        holds: Holds(Key) = .{},
+        failures: ?*std.atomic.Value(u64) = null,
+        warned: u64 = 0,
+
+        pub fn init(gpa: std.mem.Allocator) Self {
+            return .{ .gpa = gpa };
+        }
+        pub fn deinit(c: *Self) void {
+            c.holds.deinit(c.gpa);
+            c.* = undefined;
+        }
+
+        pub fn capture(c: *Self, s: G.Stream, key: Key, site: anytype) !void {
+            if (c.holds.eager(key)) return site.body();
+            try site.reserve();
+            const exec = record(s, site) catch |err| {
+                site.undo();
+                if (!retryable(err)) return err;
+                if (!(G.ready(s) catch false)) return err;
+                const hold = c.holds.fail(c.gpa, key) catch null;
+                if (c.failures) |counter| _ = counter.fetchAdd(1, .monotonic);
+                if (hold == null or hold.?.fails == 1) {
+                    c.warned += 1;
+                    std.log.warn("dsv41: CUDA capture failed ({t}) at {any}; eager fallback, next capture after {d} uses", .{ err, key, if (hold) |h| h.left else 0 });
+                }
+                return site.body();
+            };
+            site.keep(exec);
+            c.holds.clear(key);
+            try G.launch(exec, s);
+        }
+
+        fn record(s: G.Stream, site: anytype) !G.Exec {
+            try G.begin(s);
+            site.body() catch |err| {
+                if (G.end(s)) |got| {
+                    var g = got;
+                    G.dropGraph(&g);
+                } else |_| {}
+                return err;
+            };
+            var graph = try G.end(s);
+            defer G.dropGraph(&graph);
+            return G.instantiate(graph);
+        }
+    };
+}
