+fn snapshotEndGrid(len: usize, window: usize, fine: bool, grid: usize) usize {
+    if (len == 0) return 0;
+    const safe = @min(len -| window, len - 1);
+    const stock = safe / model.chunk_rows * model.chunk_rows;
+    if (!fine) return stock;
+    const candidate = safe / grid * grid;
+    if (candidate == stock) return stock;
+    // The new split may replace an existing call boundary but must not add a cold fill call.
+    const stock_calls = 1 + (len - stock - 1) / model.chunk_rows;
+    const fine_calls = 2 + (len - candidate - 1) / model.chunk_rows;
+    return if (fine_calls == stock_calls) candidate else stock;
