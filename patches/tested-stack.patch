+        }
+    };
+    if (gate.enter(std.testing.io, estimated, Cancel{ .calls = &checks })) |ticket| {
+        defer gate.leave(std.testing.io, ticket);
+        std.debug.print("first prepare admitted: available={} MiB, estimate={} MiB, floor={} MiB, cancellation_checks={}\n", .{ fakeAvail(std.testing.io).? >> 20, estimated >> 20, gate.floor >> 20, checks });
