+//! Local-only HTTP regression fixture: the existing scripted engine and full server, with deterministic MemAvailable.
+const std = @import("std");
+const server = @import("server");
+const FakeText = @import("fake_text.zig").FakeText;
+const ScriptEngine = @import("fake_engine.zig").ScriptEngine;
+
+fn noMemory(_: std.Io) ?u64 {
+    return 0;
+}
+
+pub fn main(init: std.process.Init) !void {
+    const a = init.arena.allocator();
+    const argv = try init.minimal.args.toSlice(a);
+    const dir = argv[2];
+    const vocab_bytes = try std.Io.Dir.cwd().readFileAlloc(init.io, try std.fs.path.join(a, &.{ dir, "vocab.json" }), a, .limited(1 << 20));
+    const vocab = try std.json.parseFromSliceLeaky(std.json.Value, a, vocab_bytes, .{});
+    var pieces: std.ArrayList([]const u8) = .empty;
+    for (vocab.object.get("pieces").?.array.items) |p| try pieces.append(a, p.string);
+    var text = FakeText.init(pieces.items);
+    const scripts_bytes = try std.Io.Dir.cwd().readFileAlloc(init.io, try std.fs.path.join(a, &.{ dir, "scripts.json" }), a, .limited(4 << 20));
+    const scripts = try std.json.parseFromSliceLeaky(std.json.Value, a, scripts_bytes, .{});
+    const context = try std.fmt.parseInt(u32, init.environ_map.get("TF_FAKE_CONTEXT") orelse "1024", 10);
+    var engine: ScriptEngine = .{ .gpa = init.gpa, .io = init.io, .text = text.text(), .scripts = scripts, .info_ = .{ .lanes = 4, .context_window = context, .call_gates = true } };
+    const floor = try std.fmt.parseFloat(f64, init.environ_map.get("TENSORFOLD_PREPARE_FLOOR_GIB") orelse "3");
+    const srv = try server.Server.init(init.gpa, init.io, engine.engine(), text.text(), .{
+        .served_name = "fake-model",
+        .model_ids = &.{"fake-model"},
+        .enable_thinking = false,
+        .use_drafts = false,
+        .prepare_floor_gib = floor,
+    }, null);
+    defer srv.deinit();
+    if (floor > 3) srv.gate.avail = noMemory;
+    const listener = try server.listener.Listener.open(.{ .ip4 = .loopback(0) });
+    defer listener.close();
+    std.debug.print("PORT {d}\n", .{listener.port()});
+    const stop: std.atomic.Value(bool) = .init(false);
+    srv.serve(listener, &stop);
+}
