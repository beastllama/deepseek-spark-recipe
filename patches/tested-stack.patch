+    }
+    fn get(l: *@This(), key: TestKey) ?*Kept {
+        return l.map.getPtr(key);
+    }
+    fn capture(l: *@This(), s: Fake.Stream, key: TestKey, site: *FakeSite) !void {
+        var owned: Site = .{ .l = l, .key = key, .site = site };
